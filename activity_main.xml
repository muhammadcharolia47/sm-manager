    <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:layout_weight="1" android:orientation="vertical" android:background="@color/card" android:padding="16dp" android:layout_marginEnd="8dp" android:layout_width="0dp" android:layout_height="100dp">
        <TextView android:text="TODAY'S SALES" android:textColor="@color:muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="₹0" android:textColor="@color:white" android:textStyle="bold" android:textSize="24sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
      <LinearLayout android:layout_weight="1" android:orientation="vertical" android:background="@color/card" android:padding="16dp" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_height="100dp">
        <TextView android:text="COLLECTION" android:textColor="@color:muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="₹0" android:textColor="@color:gold" android:textStyle="bold" android:textSize="24sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      </LinearLayout>
    </LinearLayout>
    <TextView android:text="QUICK ACTIONS" android:textColor="@color:white" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:text="＋ SALE" android:textColor="@color:black_bg" android:backgroundTint="@color/gold" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
    <Button android:text="＋ PAYMENT" android:textColor="@color:black_bg" android:backgroundTint="@color/gold" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
    <Button android:text="＋ PURCHASE" android:textColor="@color:black_bg" android:backgroundTint="@color/gold" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
    <Button android:text="＋ EXPENSE" android:textColor="@color:black_bg" android:backgroundTint="@color/gold" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
    <TextView android:text="Coming next: Parties • Stock • Invoices • Purchase Scanner • Production • Reports • Local Backup" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="30dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
</ScrollView>
